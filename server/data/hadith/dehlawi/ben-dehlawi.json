{
  "metadata": {
    "name": "শাহ ওয়ালিউল্লাহ দেহলভীর চল্লিশ হাদিস",
    "sections": {
      "0": "ছয়টি সহীহ হাদীস",
      "1": "الأربعون حديثاً للشاه ولي الله الدهلوي"
    },
    "section_details": {
      "0": {
        "hadithnumber_first": 0,
        "hadithnumber_last": 0,
        "arabicnumber_first": 0,
        "arabicnumber_last": 0
